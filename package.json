{
  "name": "brease-client",
  "version": "0.1.0",
  "description": "Brease delivery API client for Next.js, Astro and any fetch-capable runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designatives/brease-client.git"
  },
  "homepage": "https://github.com/designatives/brease-client#readme",
  "bugs": "https://github.com/designatives/brease-client/issues",
  "keywords": [
    "brease",
    "cms",
    "headless",
    "nextjs",
    "astro"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js",
      "require": "./dist/astro.cjs"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js",
      "require": "./dist/html.cjs"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js",
      "require": "./dist/image.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.23.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
